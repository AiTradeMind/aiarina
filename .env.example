# AI PROVIDERS
GEMINI_API_KEY="your-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="meta-llama/llama-3-8b-instruct"

# APPLICATION CONFIG
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"
CORS_ORIGIN="*"

# DATABASE
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# IDENTITY & AUTH
# Must be at least 32 characters for production
JWT_ACCESS_SECRET="aiarina_access_secret_2026_dev_fallback_must_be_long_enough"
JWT_REFRESH_SECRET="aiarina_refresh_secret_2026_dev_fallback_must_be_long_enough"
AUTH_MODE="production"

# SUPABASE (Optional)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AUTHORIZED MARKET DATA PROVIDER CONFIGURATION
# Supported values: angelone | truedata | globaldatafeeds | nse | bse
MARKET_DATA_PROVIDER="truedata"

# ANGEL ONE SMARTAPI AUTHORIZED FEED CONFIGURATION
ANGELONE_API_KEY=""
ANGELONE_CLIENT_CODE=""
ANGELONE_PIN=""
ANGELONE_TOTP_SECRET=""
ANGELONE_WS_URL="wss://smartapisocket.angelone.in/smart-stream"
ANGELONE_BASE_URL="https://apiconnect.angelone.in"

# TRUEDATA AUTHORIZED FEED CONFIGURATION
TRUEDATA_API_KEY=""
TRUEDATA_API_SECRET=""
TRUEDATA_WS_URL="wss://ws.truedata.in"
TRUEDATA_BASE_URL="https://api.truedata.in/v1"

# GLOBAL DATAFEEDS AUTHORIZED FEED CONFIGURATION
GLOBALDATAFEEDS_API_KEY=""
GLOBALDATAFEEDS_API_SECRET=""
GLOBALDATAFEEDS_WS_URL="wss://ws.globaldatafeeds.in/v1"
GLOBALDATAFEEDS_BASE_URL="https://api.globaldatafeeds.in/v1"

# AUTHORIZED NSE & BSE MARKET DATA FEED
NSE_MARKET_DATA_API_KEY=""
NSE_MARKET_DATA_API_SECRET=""
NSE_MARKET_DATA_WS_URL="wss://api.nseindia.com/v1/ws"
NSE_MARKET_DATA_BASE_URL="https://api.nseindia.com/v1"

BSE_MARKET_DATA_API_KEY=""
BSE_MARKET_DATA_API_SECRET=""
BSE_MARKET_DATA_WS_URL="wss://api.bseindia.com/v1/ws"
BSE_MARKET_DATA_BASE_URL="https://api.bseindia.com/v1"

# OBSERVABILITY
LOG_LEVEL="info"
